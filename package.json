{
  "name": "electron-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "description": "Lean Electron + Vue 3 + TypeScript + Vite+ starter",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test --run",
    "dist:dir": "vp build && electron-builder --dir",
    "smoke": "node scripts/smoke.mjs",
    "dist:win": "vp build && electron-builder --win nsis --publish never",
    "dist:mac": "vp build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "vp build && electron-builder --linux AppImage deb --publish never",
    "hot:pack": "node --experimental-strip-types scripts/pack-hot.ts",
    "typecheck:vue": "vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "element-plus": "^2.14.7",
    "fflate": "^0.8.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.24",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "44.5.1",
    "electron-builder": "^26.17.0",
    "typescript": "^6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plugin-electron": "^1.0.0",
    "vite-plus": "1.3.0",
    "vue-tsc": "3.3.13"
  },
  "author": {
    "name": "Electron Starter Maintainers",
    "email": "replace-before-release@example.com"
  },
  "desktopName": "electron-starter"
}
