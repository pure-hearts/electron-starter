# ========================================================
# 客户端环境变量（必须以 VITE_ 前缀开头，暴露给渲染进程）
# ========================================================
# 当前运行环境 (development | production | testing)
VITE_APP_ENV=development

# 应用窗口标题
VITE_APP_TITLE=Electron Starter

# 后端 REST API 基准地址
VITE_API_BASE_URL=

# 本地开发跨域代理目标地址（例如 http://localhost:8080，配置后自动将 /api 代理转发至该目标）
VITE_DEV_PROXY_TARGET=

# 客户端自定义协议 Scheme（用于 Deep Link 唤起与测试）
VITE_APP_DEEP_LINK_SCHEME=electron-starter

# 功能校验页面（Playground）默认测试下载地址
VITE_APP_DOWNLOAD_TEST_URL=

# ========================================================
# 主进程及系统级环境变量（Node.js 端，不暴露给前端 Bundle）
# ========================================================
# 应用基础名称与 Windows 原生通知 ID
APP_NAME=electron-starter
APP_USER_MODEL_ID=com.electron.starter
APP_DEEP_LINK_SCHEME=electron-starter

# 应用运行日志级别 (error | warn | info | debug)
APP_LOG_LEVEL=info

# 应用全量安装包更新源地址（留空则默认读取 electron-builder 的 GitHub Releases 仓库配置）
APP_UPDATE_URL=

# 应用轻量增量热更新 Manifest 地址
HOT_UPDATE_URL=
